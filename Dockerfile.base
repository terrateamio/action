ARG BASE_IMAGE=debian:trixie-20261104-slim
FROM ${BASE_IMAGE}

# The base workflows pass the build date as OS_REFRESH. A new value makes BuildKit run
# this layer, and every layer after it, again.
ARG OS_REFRESH=
RUN echo "OS_REFRESH: ${OS_REFRESH}" && \
	apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
	apt-utils \
	bash \
	ca-certificates \
	curl \
	git \
	gnupg \
	groff-base \
	jq \
	less \
	libcap2 \
	openssh-client \
	openssl \
	python3 \
	python3-pip \
	python3-toml \
	python3-venv \
	python3-pycryptodome \
	python3-requests \
	python3-yaml \
	unzip \
	&& rm -rf /var/lib/apt/lists/*

# `git lfs install --system` writes the git-lfs filter entries to /etc/gitconfig.
# `aws help` renders through /usr/bin/groff, which groff-base provides.
ARG GIT_LFS_VERSION=v3.8.1
RUN ARCH=$(dpkg --print-architecture) && \
    mkdir /tmp/git-lfs && \
    curl -fsSL -o /tmp/git-lfs/git-lfs.tar.gz "https://github.com/git-lfs/git-lfs/releases/download/${GIT_LFS_VERSION}/git-lfs-linux-${ARCH}-${GIT_LFS_VERSION}.tar.gz" && \
    tar -C /tmp/git-lfs --strip-components=1 -xzf /tmp/git-lfs/git-lfs.tar.gz && \
    mv /tmp/git-lfs/git-lfs /usr/bin/git-lfs && \
    git lfs install --system && \
    rm -rf /tmp/git-lfs

ARG TENV_LATEST_VERSION=v4.15.1
RUN echo "TENV_LATEST_VERSION: ${TENV_LATEST_VERSION}" && \
    ARCH=$(dpkg --print-architecture) && \
    curl -O -L "https://github.com/tofuutils/tenv/releases/download/${TENV_LATEST_VERSION}/tenv_${TENV_LATEST_VERSION}_${ARCH}.deb" && \
    dpkg -i "tenv_${TENV_LATEST_VERSION}_${ARCH}.deb" && \
    rm -f "tenv_${TENV_LATEST_VERSION}_${ARCH}.deb"

ARG TOFU_VERSIONS=1.12.12
ARG TERRAFORM_VERSIONS=
# Install tofu and terraform versions dynamically based on TOFU_VERSIONS and TERRAFORM_VERSIONS. versions should be comma separated.
RUN set -e; \
    retry() { \
        n=1; \
        while true; do \
            if "$@"; then return 0; fi; \
            if [ "${n}" -ge 3 ]; then break; fi; \
            echo "attempt ${n}/3 failed, retrying in $((n * 10))s: $*" >&2; \
            sleep $((n * 10)); \
            n=$((n + 1)); \
        done; \
        echo "failed after 3 attempts: $*" >&2; \
        return 1; \
    }; \
    for version in $(echo "${TOFU_VERSIONS}" | tr ',' ' '); do retry tenv tofu install "${version}"; sleep 5; done; \
    for version in $(echo "${TERRAFORM_VERSIONS}" | tr ',' ' '); do retry tenv terraform install "${version}"; sleep 5; done

ENV INFRACOST_VERSION=v0.10.47
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/g' | sed 's/aarch64/arm64/g') && \
    curl -fsSL -o /tmp/infracost-linux-${ARCH}.tar.gz "https://github.com/infracost/infracost/releases/download/${INFRACOST_VERSION}/infracost-linux-${ARCH}.tar.gz" && \
    tar -C /tmp -xzf /tmp/infracost-linux-${ARCH}.tar.gz && \
    mv /tmp/infracost-linux-${ARCH} /usr/local/bin/infracost && \
    rm -f /tmp/infracost-linux-${ARCH}.tar.gz

ENV CONFTEST_VERSION=0.71.1
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/g' | sed 's/aarch64/arm64/g') && \
    GO_VERSION=1.27.4 && \
    case "${ARCH}" in \
        amd64) GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840 ;; \
        arm64) GO_SHA256=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92 ;; \
        *) echo "no Go checksum for ${ARCH}" >&2; exit 1 ;; \
    esac && \
    mkdir /tmp/conftest && \
    curl -fsSL -o /tmp/conftest/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" && \
    echo "${GO_SHA256}  /tmp/conftest/go.tar.gz" | sha256sum -c - && \
    tar -C /tmp/conftest -xzf /tmp/conftest/go.tar.gz && \
    export GOROOT=/tmp/conftest/go GOPATH=/tmp/conftest/gopath GOCACHE=/tmp/conftest/gocache \
        GOTOOLCHAIN=local GOFLAGS=-modcacherw CGO_ENABLED=0 GODEBUG= && \
    /tmp/conftest/go/bin/go mod download "github.com/open-policy-agent/conftest@v${CONFTEST_VERSION}" && \
    cd "${GOPATH}/pkg/mod/github.com/open-policy-agent/conftest@v${CONFTEST_VERSION}" && \
    /tmp/conftest/go/bin/go build -trimpath \
        -ldflags "-s -w -X github.com/open-policy-agent/conftest/internal/version.Version=${CONFTEST_VERSION}" \
        -o /usr/local/bin/conftest . && \
    cd / && \
    rm -rf /tmp/conftest && \
    conftest --version

ENV OPA_VERSION=1.7.1

ARG AWSCLI_VERSION=2.13.26
RUN echo "AWSCLI_VERSION: ${AWSCLI_VERSION}" && \
    ARCH=$(uname -m) && \
    mkdir /tmp/awscli && \
    curl -fsSL -o /tmp/awscli/awscli.zip "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" && \
    unzip -q /tmp/awscli/awscli.zip -d /tmp/awscli/ && \
    /tmp/awscli/aws/install > /dev/null && \
    rm -rf /tmp/awscli

ENV CHECKOV_VERSION=3.3.16
RUN python3 -m venv /opt/checkov && \
    /opt/checkov/bin/pip install --no-cache-dir checkov==${CHECKOV_VERSION} && \
    ln -s /opt/checkov/bin/checkov /usr/local/bin/checkov

# The release the stategraph proxy on PATH runs. The proxy replaces it when
# STATEGRAPH_VERSION asks for another version. The base workflows pass the latest release
# as STATEGRAPH_LATEST_VERSION, because a step that looks the release up has the same text
# on every build, so BuildKit serves it from cache and a rebuild keeps the first build's
# release. Without the argument the step looks it up, from the github.com redirect, not
# api.github.com, whose unauthenticated rate limit shared runners exhaust.
ARG STATEGRAPH_LATEST_VERSION=
RUN echo "STATEGRAPH_LATEST_VERSION: ${STATEGRAPH_LATEST_VERSION}" && \
    URL="${STATEGRAPH_LATEST_VERSION:-$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/stategraph/releases/releases/latest)}" && \
    VERSION="${URL##*/}" && \
    ARCH=$(uname -m | sed 's/x86_64/amd64/g' | sed 's/aarch64/arm64/g') && \
    curl -fsSL -o /tmp/stategraph.tar.gz "https://github.com/stategraph/releases/releases/download/${VERSION}/stategraph-${VERSION}-linux-${ARCH}.tar.gz" && \
    tar -C /tmp -xzf /tmp/stategraph.tar.gz stategraph && \
    install -D -m 0755 /tmp/stategraph /opt/stategraph/bin/stategraph && \
    rm -f /tmp/stategraph /tmp/stategraph.tar.gz && \
    /opt/stategraph/bin/stategraph --version

ENV RESOURCELY_VERSION=1.0.45

COPY ./bin/ /usr/local/bin
COPY proxy/bin /usr/local/proxy/bin
COPY conftest-wrapper /usr/local/bin/conftest-wrapper
COPY checkov-wrapper /usr/local/bin/checkov-wrapper
COPY cdktf-setup.sh /cdktf-setup.sh
COPY gcloud-cli-setup.sh /gcloud-cli-setup.sh
COPY azure-cli-setup.sh /azure-cli-setup.sh
COPY kubectl-cli-setup.sh /kubectl-cli-setup.sh

RUN mkdir /usr/local/share/keys

RUN curl --output /usr/local/share/keys/hashicorp-pgp-key.txt https://www.hashicorp.com/.well-known/pgp-key.txt
ENV TFENV_HASHICORP_PGP_KEY=/usr/local/share/keys/hashicorp-pgp-key.txt

RUN curl --output /usr/local/share/keys/opentofu.asc https://get.opentofu.org/opentofu.asc
ENV TOFUENV_OPENTOFU_PGP_KEY=/usr/local/share/keys/opentofu.asc

# HashiCorp's signatures for old releases of Terraform have expired so we can only do hash checks
ENV TENV_VALIDATION=sha

ARG ADDITIONAL_PKGS_TO_INSTALL
# Install additional OS packages dynamically based on ADDITIONAL_PKGS_TO_INSTALL. versions should be comma separated.
RUN if [ -n "${ADDITIONAL_PKGS_TO_INSTALL}" ]; then \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $(echo "${ADDITIONAL_PKGS_TO_INSTALL}" | tr ',' ' ') && \
    rm -rf /var/lib/apt/lists/*; \
    fi
