#!/usr/bin/env bash
set -euf -o pipefail

# Check the image reference in fips/action.yml.
#
# Two separate jobs, with different severities:
#
#   1. The reference MUST name a digest. A movable tag there means a consumer
#      who pins this repository by tag or by commit SHA does not get a frozen
#      FIPS action, because the image is fetched at run time rather than built
#      from the tree. Failing to pin is an error.
#
#   2. If a newer image exists for the same major line, say so. This is a
#      convenience, not a rule: main is expected to trail the newest release
#      between releases, so this never fails.
#
# The registry is read anonymously, because the packages are public. A lookup
# failure is reported and ignored, so that a registry outage cannot block a
# pull request.
#
# Outputs (GITHUB_OUTPUT):
#   pinned_ref     - the full reference found in the file
#   pinned_digest  - the digest it names
#   pinned_tag     - the tag it names, e.g. v1.1.0
#   major_tag      - the major line that tag belongs to, e.g. v1
#   latest_digest  - the digest that major tag resolves to now, or empty
#   stale          - true when latest_digest is known and differs

FILE="${1:-fips/action.yml}"

fail () {
  echo "Error: $*" >&2
  exit 1
}

emit () {
  [[ -n "${GITHUB_OUTPUT:-}" ]] && echo "$1" >> "${GITHUB_OUTPUT}"
  return 0
}

[[ -f "${FILE}" ]] || fail "${FILE} not found"

# The one `image:` line under `runs:`. Matching the quoted form keeps this from
# picking up a commented-out or indented-differently line by accident.
REF=$(sed -n "s/^  image: '\(.*\)'\$/\1/p" "${FILE}")
[[ -n "${REF}" ]] || fail "no \`  image: '...'\` line in ${FILE}"

case "${REF}" in
  docker://*) ;;
  *) fail "${FILE} does not use a docker:// image reference: ${REF}" ;;
esac

IMAGE="${REF#docker://}"

if [[ ! "${IMAGE}" =~ ^([^@]+):([^@:/]+)@(sha256:[0-9a-f]{64})$ ]]; then
  cat >&2 <<MSG
Error: ${FILE} must pin the FIPS image by digest.

  found:    ${IMAGE}
  expected: <name>:<tag>@sha256:<64 hex>

The FIPS action runs a prebuilt image, so a movable tag here means that pinning
this repository by tag or by commit SHA does not freeze what the action runs.
The release workflow writes this line. Do not hand-edit it to a bare tag.
MSG
  exit 1
fi

NAME="${BASH_REMATCH[1]}"
PINNED_TAG="${BASH_REMATCH[2]}"
PINNED_DIGEST="${BASH_REMATCH[3]}"
MAJOR_TAG="${PINNED_TAG%%.*}"

echo "Pinned: ${NAME}:${PINNED_TAG}@${PINNED_DIGEST}"
emit "pinned_ref=${IMAGE}"
emit "pinned_digest=${PINNED_DIGEST}"
emit "pinned_tag=${PINNED_TAG}"
emit "major_tag=${MAJOR_TAG}"

case "${NAME}" in
  ghcr.io/*) REPO="${NAME#ghcr.io/}" ;;
  *)
    echo "Not a ghcr.io image, skipping the freshness check." >&2
    emit "latest_digest="
    emit "stale=false"
    exit 0
    ;;
esac

ACCEPT='application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json'

LATEST=""
if TOKEN=$(curl -fsS --max-time 30 "https://ghcr.io/token?scope=repository:${REPO}:pull&service=ghcr.io" \
           | sed -n 's/.*"token":"\([^"]*\)".*/\1/p'); then
  LATEST=$(curl -fsS --max-time 30 -o /dev/null -D - \
             -H "Authorization: Bearer ${TOKEN}" -H "Accept: ${ACCEPT}" \
             "https://ghcr.io/v2/${REPO}/manifests/${MAJOR_TAG}" \
           | tr -d '\r' | sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: //p') || LATEST=""
fi

if [[ -z "${LATEST}" ]]; then
  echo "Could not resolve ${NAME}:${MAJOR_TAG}. Skipping the freshness check." >&2
  emit "latest_digest="
  emit "stale=false"
  exit 0
fi

emit "latest_digest=${LATEST}"

if [[ "${LATEST}" == "${PINNED_DIGEST}" ]]; then
  echo "Up to date with ${NAME}:${MAJOR_TAG}."
  emit "stale=false"
else
  echo "A newer image exists for ${NAME}:${MAJOR_TAG}: ${LATEST}"
  emit "stale=true"
fi
