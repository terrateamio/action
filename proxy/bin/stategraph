#! /usr/bin/env bash

set -e
set -u

# The base image installs the latest release here, off PATH, so that this proxy is the
# `stategraph` that runs. STATEGRAPH_VERSION replaces it with another version.
STATEGRAPH=/opt/stategraph/bin/stategraph

ARCH=$(uname -m | sed 's/x86_64/amd64/g' | sed 's/aarch64/arm64/g')

if [ ! -f "${STATEGRAPH}" ] \
       || { [ -n "${STATEGRAPH_VERSION:-}" ] && [ "$("${STATEGRAPH}" --version)" != "${STATEGRAPH_VERSION}" ]; }; then
    VERSION="${STATEGRAPH_VERSION:-$(curl -fsSL https://api.github.com/repos/stategraph/releases/releases/latest \
        | grep '"tag_name"' | head -1 | cut -d'"' -f4)}"

    flock /tmp/stategraph-install \
          curl -fsSL \
          -o /tmp/stategraph-"${VERSION}"-linux-"${ARCH}".tar.gz \
          "https://github.com/stategraph/releases/releases/download/${VERSION}/stategraph-${VERSION}-linux-${ARCH}.tar.gz"

    flock /tmp/stategraph-install tar -xzf /tmp/stategraph-"${VERSION}"-linux-"${ARCH}".tar.gz -C /tmp
    flock /tmp/stategraph-install install -D -m 0755 /tmp/stategraph "${STATEGRAPH}"
fi

exec "${STATEGRAPH}" "$@"
