#! /usr/bin/env bash

set -e
set -u

# ansible goes in a venv: a raw `pip install` fails on Debian trixie (PEP 668
# externally-managed-environment). The venv persists for the life of the
# container, so subsequent invocations exec it directly. passlib backs the
# password_hash filter, which looks for the stdlib crypt module that Python 3.13
# removed.
ANSIBLE_VERSION="${ANSIBLE_VERSION:-}"
ANSIBLE_VENV=/opt/ansible
ANSIBLE_CORE=ansible-core

if [[ -n "${ANSIBLE_VERSION}" ]]; then
    ANSIBLE_CORE="ansible-core==${ANSIBLE_VERSION}"
fi

if [[ ! -x "${ANSIBLE_VENV}/bin/ansible-playbook" ]]; then
    flock /tmp/ansible-playbook-install \
        bash -c "python3 -m venv '${ANSIBLE_VENV}' && '${ANSIBLE_VENV}/bin/pip' install '${ANSIBLE_CORE}' ansible pywinrm passlib" 1>&2
elif [[ -n "${ANSIBLE_VERSION}" ]]; then
    INSTALLED_VERSION=$("${ANSIBLE_VENV}/bin/ansible-playbook" --version 2>/dev/null \
        | sed -n 's/^ansible-playbook \[core \([0-9.]*\)\].*/\1/p' | head -n1 || echo "")
    if [[ "${INSTALLED_VERSION}" != "${ANSIBLE_VERSION}" ]]; then
        flock /tmp/ansible-playbook-install \
            "${ANSIBLE_VENV}/bin/pip" install --upgrade "${ANSIBLE_CORE}" ansible pywinrm passlib 1>&2
    fi
fi

exec "${ANSIBLE_VENV}/bin/ansible-playbook" "$@"
